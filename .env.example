# 复制为 .env 或写入 config 私有仓 local/ubuntu/env/melete.env
# ⚠️ 凭证类一律无默认值 —— 生产忘配应当启动失败，优于默默连错库

# 素材收件区根目录（不入库）。默认 ~/melete-inbox
# 结构: $MELETE_INBOX/<bank-slug>/<素材文件>
MELETE_INBOX=/home/you/melete-inbox

# 数据库（开发 = 局域网 MySQL / 生产 = TiDB Cloud，均由 Secret 注入）
MELETE_DB_DSN=user:password@tcp(host:3306)/melete?charset=utf8mb4&parseTime=true

# access token 签发/验签密钥（HS256，32+ 字节）。仅 API 持有 ——
# token 由 API 独家签发，web 与 iOS 都只是持有者
MELETE_JWT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 登录限流（非凭证）
MELETE_LOGIN_RATE_MAX=10
MELETE_LOGIN_RATE_WINDOW=1m

# Claude API（AI 富化与在线问答）
MELETE_ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Akasha OIDC
MELETE_OIDC_ISSUER=https://<akasha-host>
MELETE_OIDC_CLIENT_ID=melete
MELETE_OIDC_CLIENT_SECRET=xxxxxxxx

# 后端服务（非凭证类，允许默认值）
MELETE_ADDR=:8080
MELETE_DB_MAX_CONNS=20
MELETE_LOG_LEVEL=info

# 前端：后端 API 地址
MELETE_API_BASE=http://localhost:8080/api/v1
