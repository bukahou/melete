# 复制为 .env 或写入 config 私有仓 local/ubuntu/env/melete.env
# ⚠️ 凭证类一律无默认值 —— 生产忘配应当启动失败，优于默默连错库

# 原始 PDF 的本地路径（不入库）
MELETE_SAA_PDF=/path/to/SAA-C03.pdf

# 数据库（开发 = 局域网 MySQL / 生产 = TiDB Cloud，均由 Secret 注入）
MELETE_DB_DSN=user:password@tcp(host:3306)/melete?charset=utf8mb4&parseTime=true

# Claude API（AI 富化与在线问答）
MELETE_ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Akasha OIDC
MELETE_OIDC_ISSUER=https://<akasha-host>
MELETE_OIDC_CLIENT_ID=melete
MELETE_OIDC_CLIENT_SECRET=xxxxxxxx
